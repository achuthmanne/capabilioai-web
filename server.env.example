# ─── Capabilio Server — Environment Variables ────────────────────────────────
# Copy this file to .env.server and fill in your keys.
# NEVER commit .env.server to git.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Groq API — FREE, fast LLM. Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Razorpay — https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Razorpay WEBHOOK secret — https://dashboard.razorpay.com → Settings → Webhooks
# SEPARATE from RAZORPAY_KEY_SECRET above (different construction: webhook
# signature = HMAC-SHA256(raw_request_body, RAZORPAY_WEBHOOK_SECRET), vs the
# checkout signature = HMAC-SHA256(order_id+"|"+payment_id, RAZORPAY_KEY_SECRET)).
# Required for Career OS Workstream 4 (Mentor Marketplace) webhook route,
# backend/server/routes/mentorMarketplaceWebhook.js.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Supabase SERVICE ROLE key (NOT the anon key — server only, has write access)
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_URL=https://eybchcqwbizjmzyrviri.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...your_service_role_key_here

# ── OPTIONAL BUT RECOMMENDED ──────────────────────────────────────────────────

# ProxyCurl — best LinkedIn extraction. ~$0.01/call. https://proxycurl.com
# Without this, LinkedIn extraction works via basic scraping (may hit login walls)
PROXYCURL_API_KEY=your_proxycurl_key_here

# GitHub token — increases rate limit from 60 to 5000 req/hr
# GitHub → Settings → Developer settings → Personal access tokens → Classic
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# YouTube Data API — for real video recommendations in SkillStudio
# Google Cloud Console → APIs → YouTube Data API v3
YOUTUBE_API_KEY=AIzaSy...

# Server port (default 4000)
PORT=4000

# Partner Bridge — shared secret for capabilio-recruiter's backend to call
# this app's /api/partner/* routes server-to-server (candidate discovery,
# institutions list, company-invite accept/decline). This value must be
# set to the SAME string in BOTH deployments' env (this app's Vercel env AND
# capabilio-recruiter's Render/Vercel env). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, every /api/partner/* request 503s (fails closed) rather than
# silently allowing unauthenticated access — see backend/server/routes/
# partnerBridge.js.
PARTNER_BRIDGE_SECRET=

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────

# Career OS Workstream 4 — Mentor Marketplace v1. Default false/unset. Backend
# gate for backend/server/routes/mentorMarketplace.js,
# mentorMarketplaceAdmin.js, mentorMarketplaceWebhook.js — every route in
# those files 403s/404s while this is not "true", even if called directly.
# Mirrors frontend/src/config/featureFlags.js's mentor_marketplace_v1 (which
# reads VITE_FF_MENTOR_MARKETPLACE_V1 instead). Do not set to "true" until
# every release gate in docs/mentor-marketplace-ws4-design-proposal.md §9 is
# actually cleared, not just unit-tested.
MENTOR_MARKETPLACE_V1=false
