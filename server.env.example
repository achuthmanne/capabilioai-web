# ─── Capabilio Server — Environment Variables ────────────────────────────────
# Copy this file to .env.server and fill in your keys.
# NEVER commit .env.server to git.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Groq API — FREE, fast LLM. Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Razorpay — https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Supabase SERVICE ROLE key (NOT the anon key — server only, has write access)
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_URL=https://eybchcqwbizjmzyrviri.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...your_service_role_key_here

# ── OPTIONAL BUT RECOMMENDED ──────────────────────────────────────────────────

# ProxyCurl — best LinkedIn extraction. ~$0.01/call. https://proxycurl.com
# Without this, LinkedIn extraction works via basic scraping (may hit login walls)
PROXYCURL_API_KEY=your_proxycurl_key_here

# GitHub token — increases rate limit from 60 to 5000 req/hr
# GitHub → Settings → Developer settings → Personal access tokens → Classic
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# YouTube Data API — for real video recommendations in SkillStudio
# Google Cloud Console → APIs → YouTube Data API v3
YOUTUBE_API_KEY=AIzaSy...

# Server port (default 4000)
PORT=4000
