# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr
# Any one-off local verification build (dist_check, dist_ws2_check,
# dist_verify_cors, etc.) — none of these are ever meant to be committed.
dist_*
*.local

# Environment files — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Credentials — NEVER commit these
*serviceAccount*.json
*service-account*.json
*credentials*.json
firebase-adminsdk*.json

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build.log

# Vite temp files
vite.config.js.timestamp-*

# Misc
*.bak
_verify_pure.mjs
_verify_sync_tmp.mjs
frontend/src/config/.write_test.tmp
